---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import defaultLogo from '~/icons/logo.png';
import Astro from 'astro:global';

const logos = import.meta.glob<{ default: ImageMetadata }>('~/stores/*/icons/logo.svg');

const logo =
	Object.entries(logos).find(
		([path]) => path === `/src/stores/${Astro.locals.store}/icons/logo.svg`,
	)?.[1]?.() || defaultLogo;
---

<Image src={logo} height={32} alt="prodexa Logo" {...Astro.props} />
