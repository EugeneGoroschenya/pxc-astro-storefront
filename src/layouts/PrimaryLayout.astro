---
import '@fontsource-variable/inter';
import SEO from '~/components/layout/SEO.astro';
import SiteFooter from '~/components/layout/SiteFooter.astro';
import SiteHeader from '~/components/layout/SiteHeader.astro';
// import { SolidQueryDevtools } from '~/components/SolidQueryDevtools.tsx';
import { FATHOM_SITE_ID } from 'astro:env/client';
import '../styles.css';
import { config } from '~/config';
import defaultFavicon from '~/icons/favicon.ico';

const defaultName = config.name;
//const defaultFavicon = config.favicon;

const defaults = {
	name: defaultName,
	description: 'Ready yourself for liftoff and gear up with the latest in Astro swag.',
	image: {
		src: new URL('/social-v2.jpg?v=1', Astro.site).href,
		alt: defaultName,
	},
} as const;

type Props = {
	title: string;
};

const { title } = Astro.props;

const favicons = import.meta.glob<{ default: string }>('~/stores/*/icons/favicon.ico', {
	eager: true,
});

const favicon =
	Object.entries(favicons).find(
		([path]) => path === `/src/stores/${Astro.locals.store}/icons/favicon.ico`,
	)?.[1].default || defaultFavicon;
---

<html lang="en" class="overflow-x-clip bg-white text-theme-base-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href={favicon} />
		<!--<link rel="mask-icon" href={favicon} color="#8D46E7" />-->

		<SEO {...defaults} {title} />

		{
			FATHOM_SITE_ID && (
				<script
					src="https://cdn.usefathom.com/script.js"
					data-site={FATHOM_SITE_ID}
					is:inline
					defer
				/>
			)
		}
	</head>
	<body class="content-grid min-h-screen">
		<div class={`breakout h-0 border-b w-full border-theme-base-300`}></div>
		<SiteHeader />
		<div class={`breakout h-0 border-b w-full border-theme-base-300`}></div>
		<slot />
		<div class="pt-20">
			<SiteFooter />
		</div>
		<!--{import.meta.env.DEV && <SolidQueryDevtools client:idle />}-->
	</body>
</html>
