---
import CollectionSection from '~/stores/limango/features/collection/CollectionSection.astro';
import { applyDefaultCacheHeaders } from '~/config.ts';
import PrimaryLayout from '~/layouts/PrimaryLayout.astro';
import { config } from '~/config';

const name = config.name;

applyDefaultCacheHeaders(Astro.response.headers);
---

<PrimaryLayout title={name}>
	<main class="breakout mt-16 flex flex-col gap-y-2">
		<section>https://www.limango.de/shop</section>
	</main>
	<CollectionSection />
</PrimaryLayout>
